# 由 zela-app 的 export_scene_api 生成；与 scene_api.json 同源。
from typing import Any, List
from zela import Handle
from zela import Curve, Target, TransformChannel

# 构造圆组件。
def circle(shape: Any) -> Handle: ...

# 构造描边组件（颜色是结构体，不再是打包的 `u32`）。
def stroke(style: Any) -> Handle: ...

# 构造 2D 相机取景组件。
def camera2d(camera: Any) -> Handle: ...

# 构造 3D 相机组件（B1-D）。
def camera3d(camera: Any) -> Handle: ...

# 构造立方体网格组件（B1-D，**参数化**：只传半边长，顶点由宿主生成）。
def cube(cube: Any) -> Handle: ...

# 构造 3D 材质组件（B1-D；`metallic` / `roughness` 仅 Pbr 变体消费）。
def material3d(material: Any) -> Handle: ...

# 构造光源组件（B1-D；**不带 position** —— 位置由同对象的 `Transform` 提供）。
def light(light: Any) -> Handle: ...

# 构造 3D 摆放组件（B1-D；位置 / 四元数旋转 / 缩放，映射到原生 `Transform`）。
def transform3d(transform: Any) -> Handle: ...

# 构造书写动画组件（点表是 `Array<Vec2>`）。
def reveal(reveal: Any) -> Handle: ...

# 构造**静态折线**（S2：可见初态，仍可继续被 RevealRange 书写）。
def polyline(polyline: Any) -> Handle: ...

# 父对象引用组件（S5：声明期句柄，commit 时解析）。
def parent(parent: Any) -> Handle: ...

# 对象名组件。
def name(name: Any) -> Handle: ...

# 对象级不透明度组件（S6）。
def opacity(opacity: Any) -> Handle: ...

# 构造坐标网格组件（容器；几何由 `AxesRefreshSystem` 每帧生成）。
def axes2d(axes: Any) -> Handle: ...

# 构造箭头图元。
def arrow(arrow: Any) -> Handle: ...

# 构造实心填充样式。
def fill(fill: Any) -> Handle: ...

# 构造逐对象摆放组件。
def transform(transform: Any) -> Handle: ...

# 由内容路径构造书写对象（`Reveal` + `StrokeSolid` 组件组）。
def reveal_path(shape: Any) -> Handle: ...

# 由内容路径构造静态对象（`Path` + `StrokeSolid` 组件组）。
def path_shape(shape: Any) -> Handle: ...

# 创建对象：组件句柄列表（异构 ⇒ 保持 `Array<Opaque>`）。
def spawn(components: List[Handle]) -> Handle: ...

# 销毁对象（`commit` 时执行）。
def despawn(object: Handle) -> None: ...

# 构造动画动作：**目标枚举** + **曲线枚举**（拼错在绑定层即报错）。
def clip(target: Target, curve: Curve) -> Handle: ...

# 构造 **Transform 通道**动作（S3：Position / Rotation / Scale）。
# 
# 显式指定写哪一列，因此 `Position` 与 `Rotation` 可以在 `parallel` 里并存。
# B7 起这是写 `Transform` 的**唯一**入口（`Target.TransformValue` 已删除）。
def clip_transform(channel: TransformChannel, curve: Curve) -> Handle: ...

# 顺序播放一段动画（动作 + 时长，秒）。
def animate(object: Handle, clip: Handle, duration: float) -> None: ...

# 与**上一段**动画同区间的额外动作。
def parallel(object: Handle, clip: Handle) -> None: ...

# 推进时序游标（不产生动画段）。
def wait(seconds: float) -> None: ...

# 构造 Surface（B3 Step 0）：`Surface` + `SurfaceRenderer` + `SurfaceTexture` 组件组。
def surface(surface: Any) -> Handle: ...

# 构造组标签组件（B7 Step 4）：**纯组合**，不做父子变换累乘（与 `Parent` 分工）。
def group(group: Any) -> Handle: ...

# 构造函数图像相位组件（B7 Step 4）：`Target.Phase` 每帧写 `phase`。
def phase_anim(phase: Any) -> Handle: ...

# 构造可变形形状组件（B7 Step 4）：`Target.MorphT` 每帧写 `t`。
def morph(morph: Any) -> Handle: ...

# 构造渐变组件（PE）：色标沿两个端点的轴均匀分布（多 stop 原生支持）。
def gradient(gradient: Any) -> Handle: ...

# 构造虚线组件（PE）：单位是**曲线参数 u**，不是像素。
def dash(dash: Any) -> Handle: ...

# 构造第二套 paint 组件（PE）：`mix` 是混合进度。
def second_paint(second: Any) -> Handle: ...

# 构造背景描边组件（PE）：填充之下的第三色。
def background_stroke(background: Any) -> Handle: ...

# 构造曲线窗口组件（PE）：单位是曲线索引 + t。
def curve_window(window: Any) -> Handle: ...

